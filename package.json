{
  "name": "mangrove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vp dev --host 127.0.0.1 --port 5173 --strictPort",
    "check": "vp check && vp run check:types",
    "check:types": "vue-tsc --noEmit",
    "build": "vp run check:types && vp build",
    "test": "vp test run",
    "tauri": "tauri",
    "desktop": "vp run dev",
    "fixture": "node scripts/create-fixture.mjs",
    "test:core": "cargo test --locked -p mangrove-core",
    "test:fixture": "node --test scripts/create-fixture.test.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "@tanstack/vue-virtual": "3.13.39",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "shiki": "^4.4.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vue-tsc": "^3.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "download"
    }
  }
}
