{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Git inspection, remote fetch and a folder picker for the bundled main window.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "allow-open-repository",
    "allow-fetch-repository",
    "allow-index-status",
    "allow-list-commits",
    "allow-commit-position",
    "allow-commit-details",
    "allow-file-diff",
    "allow-working-tree-status",
    "allow-working-tree-diff"
  ]
}
