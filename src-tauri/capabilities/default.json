{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Read-only Git commands and a folder picker for the bundled main window.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "allow-open-repository",
    "allow-index-status",
    "allow-list-commits",
    "allow-commit-position",
    "allow-commit-details",
    "allow-file-diff",
    "allow-file-content",
    "allow-file-history",
    "allow-file-blame",
    "allow-file-revision-diff",
    "allow-working-tree-status",
    "allow-working-tree-diff"
  ]
}
