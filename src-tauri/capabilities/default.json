{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Git inspection, remote fetch and a folder picker for the bundled main window.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "allow-open-repository",
    "allow-fetch-repository",
    "allow-repository-names",
    "allow-index-status",
    "allow-list-commits",
    "allow-commit-position",
    "allow-commit-details",
    "allow-file-diff",
    "allow-file-content",
    "allow-file-history",
    "allow-file-blame",
    "allow-file-revision-diff",
    "allow-working-tree-status",
    "allow-working-tree-diff",
    "allow-list-worktrees",
    "allow-list-stashes",
    "allow-stash-details",
    "allow-stash-diff"
  ]
}
